From b7a41c7a6a3eafe67648cbd142054d0312603fbb Mon Sep 17 00:00:00 2001
From: mgiannetta <marcogiannetta96@gmail.com>
Date: Sun, 25 Oct 2026 09:50:28 +0100
Subject: [PATCH] libcutils: Provide weak stubs for sched_policy functions

---
 libcutils/iosched_policy.cpp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/libcutils/iosched_policy.cpp b/libcutils/iosched_policy.cpp
index 012c537ac..4c77bf18a 100644
--- a/libcutils/iosched_policy.cpp
+++ b/libcutils/iosched_policy.cpp
@@ -15,6 +15,7 @@
 */
 
 #include <cutils/iosched_policy.h>
+#include <processgroup/sched_policy.h>
 
 #include <errno.h>
 #include <fcntl.h>
@@ -32,6 +33,19 @@
 #define __android_unused __attribute__((__unused__))
 #endif
 
+extern "C" __attribute__((weak)) int set_sched_policy(int, SchedPolicy) {
+    return 0;
+}
+
+extern "C" __attribute__((weak)) int get_sched_policy(int, SchedPolicy* policy) {
+    if (policy) *policy = SP_SYSTEM_DEFAULT;
+    return 0;
+}
+
+extern "C" __attribute__((weak)) int set_cpuset_policy(int, SchedPolicy) {
+    return 0;
+}
+
 int android_set_ioprio(int pid __android_unused, IoSchedClass clazz __android_unused, int ioprio __android_unused) {
 #if defined(__ANDROID__)
     if (syscall(SYS_ioprio_set, IOPRIO_WHO_PROCESS, pid, ioprio | (clazz << IOPRIO_CLASS_SHIFT))) {
-- 
2.53.0

