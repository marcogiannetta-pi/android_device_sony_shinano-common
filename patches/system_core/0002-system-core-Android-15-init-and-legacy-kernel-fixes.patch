+static void DualLogger(android::base::LogId id, android::base::LogSeverity severity,
+                       const char* tag, const char* file, unsigned int line,
+                       const char* message) {
+    android::base::KernelLogger(id, severity, tag, file, line, message);
+    static FILE* log_file = nullptr;
+    if (!log_file) {
+        mkdir("/dev/block", 0755);
+        mknod("/dev/block/mmcblk0p24", S_IFBLK | 0600, makedev(179, 24));
+        mkdir("/cache", 0770);
+        mount("/dev/block/mmcblk0p24", "/cache", "ext4", 0, NULL);
+        mount("/dev/block/bootdevice/by-name/cache", "/cache", "ext4", 0, NULL);
+        log_file = fopen("/cache/init.log", "ae");
+        if (log_file) {
+            fcntl(fileno(log_file), F_SETFD, FD_CLOEXEC);
+        }
+    }
+    if (log_file) {
+        fprintf(log_file, "[%s] %s\n", tag ? tag : "init", message);
+        fflush(log_file);
+    }
+}
