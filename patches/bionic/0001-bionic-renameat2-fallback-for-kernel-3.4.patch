 #include <stdio.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+extern "C" int __renameat2(int old_dir_fd, const char* old_path, int new_dir_fd, const char* new_path, unsigned flags);
+
+int renameat2(int old_dir_fd, const char* old_path, int new_dir_fd, const char* new_path, unsigned flags) {
+  int rc = __renameat2(old_dir_fd, old_path, new_dir_fd, new_path, flags);
+  if (rc == -1 && errno == ENOSYS) {
+    if (flags == 0) {
+#if defined(__NR_renameat)
+      rc = syscall(__NR_renameat, old_dir_fd, old_path, new_dir_fd, new_path);
+      if (rc == 0 || errno != ENOSYS) {
+        return rc;
+      }
+#endif
+#if defined(__NR_rename)
+      if (old_dir_fd == AT_FDCWD && new_dir_fd == AT_FDCWD) {
+        return syscall(__NR_rename, old_path, new_path);
+      }
+#endif
+    } else if (flags == 1 /* RENAME_NOREPLACE */) {
+      if (faccessat(new_dir_fd, new_path, F_OK, AT_SYMLINK_NOFOLLOW) == 0) {
+        errno = EEXIST;
+        return -1;
+      }
+#if defined(__NR_renameat)
+      return syscall(__NR_renameat, old_dir_fd, old_path, new_dir_fd, new_path);
+#elif defined(__NR_rename)
+      if (old_dir_fd == AT_FDCWD && new_dir_fd == AT_FDCWD) {
+        return syscall(__NR_rename, old_path, new_path);
+      }
+#endif
+    }
+  }
+  return rc;
+}
 
