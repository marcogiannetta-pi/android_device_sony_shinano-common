From: mgiannetta <marcogiannetta96@gmail.com>
Date: Tue, 3 Nov 2026 10:26:57 +0100
Subject: [PATCH] libhidl: allow non-enforced vintf on legacy devices

Change-Id: I4661acf3cee01264de1ec804af521a3dd1556aa1
---
 transport/ServiceManagement.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/transport/ServiceManagement.cpp b/transport/ServiceManagement.cpp
index b5e02df..9545802 100644
--- a/transport/ServiceManagement.cpp
+++ b/transport/ServiceManagement.cpp
@@ -934,7 +934,7 @@ sp<::android::hidl::base::V1_0::IBase> getRawServiceInternal(const std::string&
               "enable PRODUCT_ENFORCE_VINTF_MANIFEST on this device (this is also enabled by "
               "PRODUCT_FULL_TREBLE). PRODUCT_ENFORCE_VINTF_MANIFEST will ensure that no race "
               "condition is possible here.");
-        sleep(1);
+        // sleep(1); // Removed: causes watchdog ANR/hang on legacy non-Treble devices
     }
 
     for (int tries = 0; !getStub && (vintfHwbinder || vintfLegacy); tries++) {
