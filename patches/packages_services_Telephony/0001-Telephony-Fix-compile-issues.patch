From 5fbbf0652c1822070bb289e279b70cd66c5ff77e Mon Sep 17 00:00:00 2001
From: mgiannetta <marcogiannetta96@gmail.com>
Date: Sun, 25 Oct 2026 09:51:15 +0100
Subject: [PATCH] Telephony: Fix compile issues

Change-Id: I360958177dd62a2ebfe7546becd6b488f117c4cf
---
 src/com/android/phone/CarrierConfigLoader.java   | 2 +-
 src/com/android/phone/PhoneInterfaceManager.java | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/com/android/phone/CarrierConfigLoader.java b/src/com/android/phone/CarrierConfigLoader.java
index 3451cbdae..29631b35f 100644
--- a/src/com/android/phone/CarrierConfigLoader.java
+++ b/src/com/android/phone/CarrierConfigLoader.java
@@ -1327,7 +1327,7 @@ public class CarrierConfigLoader extends ICarrierConfigLoader.Stub {
 
         // Do not allow shell UID to override the carrier config. This will not impact
         // the CTS and telephony shell commands as they use different uids
-        if (TelephonyPermissions.isShell(getBinderCallingUid())) {
+        if (getBinderCallingUid() == Process.SHELL_UID) {
             throw new SecurityException("overrideConfig cannot be invoked by shell");
         }
 
diff --git a/src/com/android/phone/PhoneInterfaceManager.java b/src/com/android/phone/PhoneInterfaceManager.java
index 48aeced2f..da5e5230a 100755
--- a/src/com/android/phone/PhoneInterfaceManager.java
+++ b/src/com/android/phone/PhoneInterfaceManager.java
@@ -8264,7 +8264,7 @@ public class PhoneInterfaceManager extends ITelephony.Stub {
     public int setAllowedCarriers(CarrierRestrictionRules carrierRestrictionRules) {
         // Shell has MODIFY_PHONE_STATE permission even without root
         // But we don't want adb shell to disable carrier restrictions
-        if (TelephonyPermissions.isShell(Binder.getCallingUid())) {
+        if (Binder.getCallingUid() == Process.SHELL_UID) {
             throw new SecurityException("setAllowedCarriers cannot be invoked by shell");
         }
         enforceModifyPermission();
-- 
2.53.0

