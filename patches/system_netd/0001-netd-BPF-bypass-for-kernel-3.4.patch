+static bool isKernelAtLeast4_9() {
+    struct utsname uts;
+    if (uname(&uts) != 0) return false;
+    int major = 0, minor = 0;
+    if (sscanf(uts.release, "%d.%d", &major, &minor) != 2) return false;
+    return (major > 4) || (major == 4 && minor >= 9);
+}
