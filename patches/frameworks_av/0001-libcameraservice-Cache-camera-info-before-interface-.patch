From 2cdc909d8dab7a460a2afa11d27c10562be04852 Mon Sep 17 00:00:00 2001
From: mgiannetta <marcogiannetta96@gmail.com>
Date: Sun, 25 Oct 2026 09:49:25 +0100
Subject: [PATCH] libcameraservice: Cache camera info before interface open and
 initialize mInfo

---
 .../common/CameraProviderManager.cpp                 | 12 ++++++------
 .../libcameraservice/common/CameraProviderManager.h  |  2 +-
 2 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/services/camera/libcameraservice/common/CameraProviderManager.cpp b/services/camera/libcameraservice/common/CameraProviderManager.cpp
index df83d106a9..88a6abcf1b 100644
--- a/services/camera/libcameraservice/common/CameraProviderManager.cpp
+++ b/services/camera/libcameraservice/common/CameraProviderManager.cpp
@@ -2340,6 +2340,12 @@ CameraProviderManager::ProviderInfo::DeviceInfo1::DeviceInfo1(const std::string&
         sp<InterfaceT> interface) :
         DeviceInfo(name, tagId, id, hardware::hidl_version{1, minorVersion},
                    publicCameraIds, resourceCost, parentProvider) {
+    // Cache camera info first so static metadata (orientation, facing) is always available
+    status_t res = cacheCameraInfo(interface);
+    if (res != OK) {
+        ALOGE("%s: Could not cache CameraInfo for device %s: %d", __FUNCTION__, id.c_str(), res);
+    }
+
     // Get default parameters and initialize flash unit availability
     // Requires powering on the camera device
     hardware::Return<Status> status = interface->open(nullptr);
@@ -2368,12 +2374,6 @@ CameraProviderManager::ProviderInfo::DeviceInfo1::DeviceInfo1(const std::string&
         mHasFlashUnit = true;
     }
 
-    status_t res = cacheCameraInfo(interface);
-    if (res != OK) {
-        ALOGE("%s: Could not cache CameraInfo", __FUNCTION__);
-        return;
-    }
-
     ret = interface->close();
     if (!ret.isOk()) {
         ALOGE("%s: Transaction error closing camera device %s after check for a flash unit: %s",
diff --git a/services/camera/libcameraservice/common/CameraProviderManager.h b/services/camera/libcameraservice/common/CameraProviderManager.h
index 31bec72a4b..f41848b43e 100644
--- a/services/camera/libcameraservice/common/CameraProviderManager.h
+++ b/services/camera/libcameraservice/common/CameraProviderManager.h
@@ -517,7 +517,7 @@ private:
                     const hardware::camera::common::V1_0::CameraResourceCost& resourceCost,
                     sp<ProviderInfo> parentProvider) :
                     mName(name), mId(id), mVersion(version), mProviderTagid(tagId),
-                    mIsLogicalCamera(false), mResourceCost(resourceCost),
+                    mIsLogicalCamera(false), mInfo{}, mResourceCost(resourceCost),
                     mStatus(hardware::camera::common::V1_0::CameraDeviceStatus::PRESENT),
                     mParentProvider(parentProvider), mHasFlashUnit(false),
                     mSupportNativeZoomRatio(false), mPublicCameraIds(publicCameraIds) {}
-- 
2.53.0

