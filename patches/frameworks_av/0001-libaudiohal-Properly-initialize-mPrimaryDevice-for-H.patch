diff --git a/media/libaudiohal/impl/DeviceHalHidl.cpp b/media/libaudiohal/impl/DeviceHalHidl.cpp
index 263ef968ba..607715df87 100644
--- a/media/libaudiohal/impl/DeviceHalHidl.cpp
+++ b/media/libaudiohal/impl/DeviceHalHidl.cpp
@@ -72,6 +72,9 @@ public:
 DeviceHalHidl::DeviceHalHidl(const sp<::android::hardware::audio::CPP_VERSION::IDevice>& device)
         : CoreConversionHelperHidl("DeviceHalHidl"),
           mDevice(device),
+#if MAJOR_VERSION <= 3
+          mPrimaryDevice(::android::hardware::audio::CPP_VERSION::IPrimaryDevice::castFrom(device)),
+#endif
           mSoundDoseWrapper(std::make_unique<DeviceHalHidl::SoundDoseWrapper>()) {
 }
 
@@ -274,6 +277,7 @@ status_t DeviceHalHidl::openOutputStream(
         return status;
     }
 
+#if MAJOR_VERSION >= 4
 #if MAJOR_VERSION == 4
     ::android::hardware::audio::CORE_TYPES_CPP_VERSION::SourceMetadata hidlMetadata;
 #else
@@ -283,6 +287,9 @@ status_t DeviceHalHidl::openOutputStream(
     RETURN_STATUS_IF_ERROR(CoreUtils::sourceMetadataFromHalV7(
             sourceMetadata, true /*ignoreNonVendorTags*/, &hidlMetadata
             ));
+#else
+    (void)sourceMetadata;
+#endif
 
 #if !(MAJOR_VERSION == 7 && MINOR_VERSION == 1)
     //TODO: b/193496180 use spatializer flag at audio HAL when available
@@ -619,6 +626,7 @@ status_t DeviceHalHidl::setConnectedState(const struct audio_port_v7 *port, bool
             result != NO_ERROR) {
         return result;
     }
+#if MAJOR_VERSION > 2
     Return<Result> ret = mDevice->setConnectedState(hidlAddress, connected);
     if (ret.isOk() || ret == Result::NOT_SUPPORTED) {
         // The framework is only interested in errors occurring due to connection state handling,
@@ -627,18 +635,30 @@ status_t DeviceHalHidl::setConnectedState(const struct audio_port_v7 *port, bool
         return NO_ERROR;
     }
     return processReturn("setConnectedState", ret);
+#else
+    (void)connected;
+    return NO_ERROR;
+#endif
 }
 
 error::Result<audio_hw_sync_t> DeviceHalHidl::getHwAvSync() {
     TIME_CHECK();
     if (mDevice == 0) return NO_INIT;
     audio_hw_sync_t value;
+#if MAJOR_VERSION > 2
     Result result;
     Return<void> ret = mDevice->getHwAvSync([&value, &result](Result r, audio_hw_sync_t v) {
         value = v;
         result = r;
     });
     RETURN_IF_ERROR(processReturn("getHwAvSync", ret, result));
+#else
+    Return<uint32_t> ret = mDevice->getHwAvSync();
+    if (!ret.isOk()) {
+        return NO_INIT;
+    }
+    value = ret;
+#endif
     return value;
 }
 
